# --- Flask ---
# Секретный ключ для подписи сессий (обязательно измените в продакшене)
SECRET_KEY=dev-secret-key-change-me

# --- Языковая модель ---
# Тип интерфейса: "openai" (OpenAI-совместимый) или "gigachat"
LLM_API_TYPE=openai

# URL для обращения к модели. Если оставить пустым, используется значение
# по умолчанию: OpenAI-совместимый -> https://api.proxyapi.ru/openai/v1 (ProxyAPI),
#               GigaChat -> https://gigachat.devices.sberbank.ru/api/v1
LLM_API_URL=

# Название модели. Если оставить пустым: openai -> gpt-4o-mini,
#                                    gigachat -> GigaChat-20
LLM_MODEL=

# Токен доступа: для OpenAI-совместимого API — API-ключ,
# для GigaChat — ключ разработчика (base64)
LLM_API_TOKEN=

# Максимальный размер текста статьи (символов), передаваемого модели
# MAX_LLM_INPUT_CHARS=24000
