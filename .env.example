# --- Flask ---
# Секретный ключ для подписи сессий (обязательно измените в продакшене)
SECRET_KEY=dev-secret-key-change-me

# --- Языковая модель: тип API ---
# Тип интерфейса: "openai" (OpenAI-совместимый) или "gigachat".
# Для переключения между сервисами достаточно изменить только эту переменную —
# ключи доступа и настройки каждого сервиса задаются отдельно.
LLM_API_TYPE=openai

# --- OpenAI-совместимый API (используется при LLM_API_TYPE=openai) ---
# API-ключ OpenAI-совместимого сервиса (например, ProxyAPI)
OPENAI_API_KEY=

# URL для обращения к модели. Если оставить пустым, используется
# https://api.proxyapi.ru/openai/v1 (ProxyAPI)
OPENAI_API_URL=

# Название модели. Если оставить пустым — gpt-4o-mini
OPENAI_MODEL=

# --- GigaChat (используется при LLM_API_TYPE=gigachat) ---
# Ключ разработчика GigaChat (строка в формате base64)
GIGACHAT_API_KEY=

# URL для обращения к модели. Если оставить пустым, используется
# https://gigachat.devices.sberbank.ru/api/v1
GIGACHAT_API_URL=

# Название модели. Если оставить пустым — GigaChat-2
GIGACHAT_MODEL=

# OAuth-эндпоинт GigaChat для получения access_token (можно не менять)
# GIGACHAT_OAUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth

# --- Прочее ---
# Максимальный размер текста статьи (символов), передаваемого модели
# MAX_LLM_INPUT_CHARS=24000

# --- Температура генерации LLM (число от 0 до 2) ---
# Чем меньше температура, тем детерминированнее и строже ответы модели.
# Проверка ответов студента
# TEMPERATURE_GRADING=0.1
# Определение типа статьи
# TEMPERATURE_TYPE_DETECTION=0.1
# Составление краткого содержания
# TEMPERATURE_SUMMARY=0.3
# Генерация экзаменационных вопросов
# TEMPERATURE_QUESTIONS=0.5
